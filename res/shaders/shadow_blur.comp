#type compute
#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r8) uniform writeonly image2D o_BlurredMask;

layout(binding = 0) uniform sampler2D u_InputMask;
layout(binding = 1) uniform sampler2D u_gDepth;
layout(binding = 2) uniform sampler2D u_gNormal;

#include "include/common.glsl"

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(o_BlurredMask);
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y) return;

    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv = (vec2(pixelCoord) + 0.5) * texelSize;

    float centerDepth = texture(u_gDepth, uv).r;
    if (centerDepth == 1.0) {
        imageStore(o_BlurredMask, pixelCoord, vec4(1.0));
        return;
    }

    vec3 centerNormal = OctDecode(texture(u_gNormal, uv).rg);
    float centerVal = texture(u_InputMask, uv).r;

    float result = 0.0;
    float totalWeight = 0.0;

    int radius = 2; // 5x5 blur
    for (int y = -radius; y <= radius; ++y) {
        for (int x = -radius; x <= radius; ++x) {
            vec2 offset = vec2(x, y) * texelSize;
            vec2 sampleUV = uv + offset;

            float sampleDepth = texture(u_gDepth, sampleUV).r;
            vec3 sampleNormal = OctDecode(texture(u_gNormal, sampleUV).rg);
            float sampleVal = texture(u_InputMask, sampleUV).r;

            // Spatial weight (Gaussian)
            float spatialWeight = exp(-(x*x + y*y) / (2.0 * 2.0));

            // Depth weight
            float depthDiff = abs(centerDepth - sampleDepth);
            float depthWeight = exp(-depthDiff * 1000.0); // Sensitive to depth

            // Normal weight
            float normalWeight = max(dot(centerNormal, sampleNormal), 0.0);
            normalWeight = pow(normalWeight, 16.0);

            float weight = spatialWeight * depthWeight * normalWeight;
            result += sampleVal * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight > 0.0) {
        result /= totalWeight;
    } else {
        result = centerVal;
    }

    imageStore(o_BlurredMask, pixelCoord, vec4(result));
}
