#type compute
#version 460 core

layout(local_size_x = 64) in;

uniform int u_TileSize;
uniform int u_TotalProbes;
uniform int u_ProbesPerRow;
uniform int u_Mode;
uniform ivec3 u_ProbeGridSize;

layout(rgba16f, binding = 0) uniform image2D u_IrradianceAtlas;
layout(rg16f, binding = 1) uniform image2D u_DistanceAtlas;

void main() {
    uint probeIndex = gl_WorkGroupID.x;
    if (probeIndex >= uint(u_TotalProbes)) return;
    
    uint tid = gl_LocalInvocationIndex;
    int tileSize = u_TileSize;
    uint totalBorder = uint(4 * tileSize - 4);
    if (tid >= totalBorder) return;
    
    ivec2 borderTexel;
    if (tid < uint(tileSize)) {
        borderTexel = ivec2(int(tid), 0);
    } else if (tid < uint(2 * tileSize)) {
        borderTexel = ivec2(int(tid - uint(tileSize)), tileSize - 1);
    } else if (tid < uint(3 * tileSize - 2)) {
        borderTexel = ivec2(0, int(tid - uint(2 * tileSize)) + 1);
    } else {
        borderTexel = ivec2(tileSize - 1, int(tid - uint(3 * tileSize - 2)) + 1);
    }
    
    // Decompose probeIndex to 3D (must match trace shader)
    int px = int(probeIndex) % u_ProbeGridSize.x;
    int py = (int(probeIndex) / u_ProbeGridSize.x) % u_ProbeGridSize.y;
    int pz = int(probeIndex) / (u_ProbeGridSize.x * u_ProbeGridSize.y);
    int atlasLinear = (pz * u_ProbeGridSize.x + px) + py * u_ProbesPerRow;
    int tileX = (atlasLinear % u_ProbesPerRow) * tileSize;
    int tileY = (atlasLinear / u_ProbesPerRow) * tileSize;
    int innerSize = tileSize - 2;
    
    ivec2 dst = borderTexel;
    ivec2 src;
    
    bool isCorner = (dst.x == 0 || dst.x == tileSize - 1) && (dst.y == 0 || dst.y == tileSize - 1);
    
    if (isCorner) {
        src.x = (dst.x == 0) ? 1 : innerSize;
        src.y = (dst.y == 0) ? 1 : innerSize;
    } else if (dst.x == 0) {
        src.x = 1;
        src.y = tileSize - 1 - dst.y;
    } else if (dst.x == tileSize - 1) {
        src.x = innerSize;
        src.y = tileSize - 1 - dst.y;
    } else if (dst.y == 0) {
        src.x = tileSize - 1 - dst.x;
        src.y = 1;
    } else if (dst.y == tileSize - 1) {
        src.x = tileSize - 1 - dst.x;
        src.y = innerSize;
    } else {
        return;
    }
    
    ivec2 globalDst = ivec2(tileX + dst.x, tileY + dst.y);
    ivec2 globalSrc = ivec2(tileX + src.x, tileY + src.y);
    
    if (u_Mode == 0) {
        vec4 val = imageLoad(u_IrradianceAtlas, globalSrc);
        imageStore(u_IrradianceAtlas, globalDst, val);
    } else {
        vec4 val = imageLoad(u_DistanceAtlas, globalSrc);
        imageStore(u_DistanceAtlas, globalDst, val);
    }
}
