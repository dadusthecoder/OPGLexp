#type compute
#version 460 core
#include "include/common.glsl"

layout(local_size_x = 64) in;

uniform ivec3 u_ProbeGridSize;
uniform vec3 u_ProbeSpacing;
uniform int u_RaysPerProbe;
uniform int u_TotalProbes;

struct ProbeRayData { vec4 radiance; vec4 direction; };

layout(std430, binding = 8) readonly buffer ProbeRayBuffer { ProbeRayData rayData[]; };
layout(std430, binding = 10) buffer ProbeStateBuffer { vec4 probeState[]; };

void main() {
    uint probeIndex = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    if (probeIndex >= uint(u_TotalProbes)) return;
    
    int backfaceCount = 0;
    int closeFrontfaceCount = 0;
    
    float minSpacing = min(u_ProbeSpacing.x, min(u_ProbeSpacing.y, u_ProbeSpacing.z));
    float threshold = 0.2 * minSpacing;
    
    uint rayStartIdx = probeIndex * uint(u_RaysPerProbe);
    vec3 offset = vec3(0.0);
    
    for (int i = 0; i < u_RaysPerProbe; ++i) {
        vec4 rayRad = rayData[rayStartIdx + i].radiance;
        vec3 rayDir = rayData[rayStartIdx + i].direction.xyz;
        float hitDist = rayRad.w;
        
        if (hitDist < 0.0) {
            backfaceCount++;
        } else if (hitDist > 0.0 && hitDist < threshold) {
            closeFrontfaceCount++;
            offset += rayDir * (threshold - hitDist);
        }
    }
    
    float state = 1.0;
    if (backfaceCount > u_RaysPerProbe / 2) {
        state = 0.0;
    }
    
    vec3 prevOffset = probeState[probeIndex].xyz;
    vec3 newOffset = prevOffset;
    
    if (state > 0.5) {
        float maxOffset = 0.5 * minSpacing;
        float offsetLen = length(offset);
        if (offsetLen > maxOffset) {
            offset = (offset / offsetLen) * maxOffset;
        }
        newOffset = mix(prevOffset, prevOffset + offset, 0.1);
    }
    
    probeState[probeIndex] = vec4(newOffset, state);
}
