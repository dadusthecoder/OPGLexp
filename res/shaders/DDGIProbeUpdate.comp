#version 460 core
#shader Compute

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "include/sampling.glsl"

uniform ivec3 u_ProbeCount;
uniform int u_RaysPerProbe;
uniform float u_Hysteresis;
uniform int u_IrradianceTexSize; // usually 8

layout(rgba16f, binding = 0) uniform image2D u_IrradianceAtlas;
layout(rg16f, binding = 1) uniform image2D u_DepthAtlas;

struct ProbeRayData {
    vec4 radiance;   // xyz = radiance at hit point, w = unused
    vec4 direction;  // xyz = ray direction, w = hit distance (-1 if miss)
};

layout(std430, binding = 6) readonly buffer ProbeRayDataBuffer {
    ProbeRayData rayData[];
};

void main() {
    ivec3 probeCoords = ivec3(gl_WorkGroupID);
    uint probeLinearIndex = uint(probeCoords.z * (u_ProbeCount.x * u_ProbeCount.y) + 
                                 probeCoords.y * u_ProbeCount.x + 
                                 probeCoords.x);
                            
    ivec2 texelCoords = ivec2(gl_LocalInvocationID.xy);
    uint rayDataOffset = probeLinearIndex * uint(u_RaysPerProbe);
    int probesPerRow = u_ProbeCount.x;

    // ==========================================
    // 1. Irradiance Update (Only first 8x8 threads)
    // ==========================================
    if (texelCoords.x < u_IrradianceTexSize && texelCoords.y < u_IrradianceTexSize) {
        int probeSizeWithBorder = u_IrradianceTexSize + 2;
        int atlasX = (int(probeLinearIndex) % probesPerRow) * probeSizeWithBorder + 1;
        int atlasY = (int(probeLinearIndex) / probesPerRow) * probeSizeWithBorder + 1;
        ivec2 globalTexelCoords = ivec2(atlasX, atlasY) + texelCoords;
        
        vec2 normalizedCoords = (vec2(texelCoords) + 0.5) / float(u_IrradianceTexSize);
        vec2 octCoords = normalizedCoords * 2.0 - 1.0;
        vec3 texelDirection = OctahedralDecode(octCoords);
        
        vec3 accumulatedRadiance = vec3(0.0);
        float totalWeight = 0.0;
        
        for (int i = 0; i < u_RaysPerProbe; i++) {
            vec3 rayDir = rayData[rayDataOffset + uint(i)].direction.xyz;
            vec3 rayRadiance = rayData[rayDataOffset + uint(i)].radiance.xyz;
            
            float weight = max(0.0, dot(texelDirection, rayDir));
            accumulatedRadiance += rayRadiance * weight;
            totalWeight += weight;
        }
        
        vec3 newIrradiance = vec3(0.0);
        if (totalWeight > 0.0001) {
            newIrradiance = accumulatedRadiance / totalWeight;
        }
        
        vec4 previousIrradiance = imageLoad(u_IrradianceAtlas, globalTexelCoords);
        if (u_Hysteresis > 0.0) {
            newIrradiance = mix(newIrradiance, previousIrradiance.rgb, u_Hysteresis);
        }
        imageStore(u_IrradianceAtlas, globalTexelCoords, vec4(newIrradiance, 1.0));
    }

    // ==========================================
    // 2. Depth Update (All 16x16 threads)
    // ==========================================
    int depthTexSize = 16;
    int depthProbeSizeWithBorder = depthTexSize + 2;
    int depthAtlasX = (int(probeLinearIndex) % probesPerRow) * depthProbeSizeWithBorder + 1;
    int depthAtlasY = (int(probeLinearIndex) / probesPerRow) * depthProbeSizeWithBorder + 1;
    ivec2 globalDepthTexelCoords = ivec2(depthAtlasX, depthAtlasY) + texelCoords;
    
    vec2 normalizedDepthCoords = (vec2(texelCoords) + 0.5) / float(depthTexSize);
    vec2 octDepthCoords = normalizedDepthCoords * 2.0 - 1.0;
    vec3 depthTexelDirection = OctahedralDecode(octDepthCoords);
    
    vec2 accumulatedDepth = vec2(0.0);
    float totalDepthWeight = 0.0;
    
    for (int i = 0; i < u_RaysPerProbe; i++) {
        vec3 rayDir = rayData[rayDataOffset + uint(i)].direction.xyz;
        float rayDist = rayData[rayDataOffset + uint(i)].direction.w;
        if (rayDist < 0.0) {
            rayDist = 50.0; // max ray distance fallback
        }
        
        // Exponentiate dot product for sharper depth transitions (reduces light leaking)
        float weight = pow(max(0.0, dot(depthTexelDirection, rayDir)), 50.0);
        
        accumulatedDepth += vec2(rayDist, rayDist * rayDist) * weight;
        totalDepthWeight += weight;
    }
    
    vec2 newDepth = vec2(0.0);
    if (totalDepthWeight > 0.0001) {
        newDepth = accumulatedDepth / totalDepthWeight;
    }
    
    vec4 previousDepth = imageLoad(u_DepthAtlas, globalDepthTexelCoords);
    if (u_Hysteresis > 0.0) {
        newDepth = mix(newDepth, previousDepth.rg, u_Hysteresis);
    }
    
    imageStore(u_DepthAtlas, globalDepthTexelCoords, vec4(newDepth, 0.0, 0.0));
}
