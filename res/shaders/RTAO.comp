#version 460 core

#include "include/common.glsl"
#include "include/sampling.glsl"
#include "include/bvh.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// G-Buffer inputs
uniform sampler2D u_gDepth;    // binding=0
uniform sampler2D u_gNormal;   // binding=1 (oct-encoded RG)
uniform sampler2D u_BlueNoise; // binding=2

// Output
layout(r8, binding = 0) writeonly uniform image2D u_AOOutput;

// Camera
uniform mat4  u_InvViewProjection;
uniform vec2  u_Resolution;
uniform int   u_FrameIndex;
uniform float u_Radius;       // AO sampling radius in world units (default: 2.0)
uniform int   u_NumRays;      // Number of AO rays (default: 8)

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(u_Resolution.x) || coord.y >= int(u_Resolution.y)) return;

    vec2 uv = (vec2(coord) + 0.5) / u_Resolution;
    float depth = texture(u_gDepth, uv).r;

    // Sky = full brightness (no occlusion)
    if (depth >= 1.0) { imageStore(u_AOOutput, coord, vec4(1.0)); return; }

    vec3 worldPos = ReconstructWorldPos(uv, depth, u_InvViewProjection);
    vec2 encodedNormal = texture(u_gNormal, uv).rg;
    vec3 N = OctDecode(encodedNormal);

    // Blue noise for jitter (spatiotemporal)
    vec2 noiseUV   = vec2(coord) / 128.0;  // tile the 128x128 noise texture
    float noiseR   = texture(u_BlueNoise, noiseUV + vec2(float(u_FrameIndex % 64) * 0.0625, 0.0)).r;
    float noiseG   = texture(u_BlueNoise, noiseUV + vec2(0.0, float(u_FrameIndex % 64) * 0.0625)).g;

    // Offset worldPos slightly along normal to avoid self-intersection
    vec3 origin = worldPos + N * 0.005;

    float occlusion = 0.0;
    for (int i = 0; i < u_NumRays; i++) {
        // Low-discrepancy + animated noise for spiral pattern
        vec2 xi = fract(Hammersley(uint(i), uint(u_NumRays)) + vec2(noiseR, noiseG));
        vec3 rayDir = TangentToWorld(CosineHemisphere(xi), N);

        // Any-hit trace
        if (TraceAnyHit(origin, rayDir, u_Radius)) {
            occlusion += 1.0;
        }
    }

    float ao = 1.0 - (occlusion / float(u_NumRays));
    imageStore(u_AOOutput, coord, vec4(ao, 0.0, 0.0, 0.0));
}
