#version 460 core
#shader Compute

// Run one thread per border pixel of a probe
layout(local_size_x = 18, local_size_y = 18, local_size_z = 1) in;

uniform ivec3 u_ProbeCount;
uniform int u_TexSize; // Irradiance size, usually 8

layout(rgba16f, binding = 0) uniform image2D u_IrradianceAtlas;
layout(rg16f, binding = 1) uniform image2D u_DepthAtlas;

// Helper function to update border for a specific atlas and size
void UpdateBorder(ivec2 localId, int texSize, int probeLinearIndex, int atlasType) {
    int probeTexSizeWithBorder = texSize + 2;
    
    // Only proceed if thread is within the block size
    if (localId.x >= probeTexSizeWithBorder || localId.y >= probeTexSizeWithBorder) {
        return;
    }
    
    // We only care about border pixels
    bool isBorder = (localId.x == 0 || localId.x == texSize + 1 || localId.y == 0 || localId.y == texSize + 1);
    if (!isBorder) return;
    
    int probesPerRow = u_ProbeCount.x;
    ivec2 atlasBase = ivec2(
        (probeLinearIndex % probesPerRow) * probeTexSizeWithBorder,
        (probeLinearIndex / probesPerRow) * probeTexSizeWithBorder
    );
    
    ivec2 srcLocal = localId;
    
    if (localId.x == 0 && localId.y > 0 && localId.y <= texSize) {
        srcLocal.x = texSize;
        srcLocal.y = texSize - localId.y + 1;
    } else if (localId.x == texSize + 1 && localId.y > 0 && localId.y <= texSize) {
        srcLocal.x = 1;
        srcLocal.y = texSize - localId.y + 1;
    } else if (localId.y == 0 && localId.x > 0 && localId.x <= texSize) {
        srcLocal.y = texSize;
        srcLocal.x = texSize - localId.x + 1;
    } else if (localId.y == texSize + 1 && localId.x > 0 && localId.x <= texSize) {
        srcLocal.y = 1;
        srcLocal.x = texSize - localId.x + 1;
    } else {
        if (localId.x == 0 && localId.y == 0) srcLocal = ivec2(texSize, texSize);
        else if (localId.x == texSize + 1 && localId.y == 0) srcLocal = ivec2(1, texSize);
        else if (localId.x == 0 && localId.y == texSize + 1) srcLocal = ivec2(texSize, 1);
        else if (localId.x == texSize + 1 && localId.y == texSize + 1) srcLocal = ivec2(1, 1);
    }
    
    ivec2 dstCoord = atlasBase + localId;
    ivec2 srcCoord = atlasBase + srcLocal;
    
    if (atlasType == 0) {
        vec4 irradiance = imageLoad(u_IrradianceAtlas, srcCoord);
        imageStore(u_IrradianceAtlas, dstCoord, irradiance);
    } else {
        vec4 depth = imageLoad(u_DepthAtlas, srcCoord);
        imageStore(u_DepthAtlas, dstCoord, depth);
    }
}

void main() {
    ivec3 probeCoords = ivec3(gl_WorkGroupID);
    uint probeLinearIndex = uint(probeCoords.z * (u_ProbeCount.x * u_ProbeCount.y) + 
                                 probeCoords.y * u_ProbeCount.x + 
                                 probeCoords.x);
    
    ivec2 localId = ivec2(gl_LocalInvocationID.xy);
    
    // Update irradiance border (TexSize = 8, Block = 10)
    UpdateBorder(localId, u_TexSize, int(probeLinearIndex), 0);
    
    // Update depth border (TexSize = 16, Block = 18)
    int depthTexSize = 16;
    UpdateBorder(localId, depthTexSize, int(probeLinearIndex), 1);
}
