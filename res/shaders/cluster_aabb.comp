#type compute
#version 460 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct ClusterAABB {
    vec4 minPoint;
    vec4 maxPoint;
};

layout(std430, binding = 0) writeonly buffer ClusterAABBBuffer {
    ClusterAABB clusters[];
};

uniform mat4 u_InvProjection;
uniform ivec3 u_GridSize;
uniform float u_ZNear;
uniform float u_ZFar;

vec4 ScreenToView(vec4 screenPos) {
    vec4 view = u_InvProjection * screenPos;
    view = view / view.w;
    return view;
}

// Line intersection with Z plane
vec3 LineIntersectionToZPlane(vec3 a, vec3 b, float zDistance) {
    vec3 normal = vec3(0.0, 0.0, 1.0);
    vec3 direction = b - a;
    float t = (zDistance - dot(normal, a)) / dot(normal, direction);
    return a + t * direction;
}

void main() {
    uint clusterIndex = gl_GlobalInvocationID.x +
                        gl_GlobalInvocationID.y * u_GridSize.x +
                        gl_GlobalInvocationID.z * (u_GridSize.x * u_GridSize.y);

    // Calculate minimum and maximum screen coordinates for this cluster tile
    vec2 tileSize = vec2(1.0) / vec2(u_GridSize.xy);
    vec2 minScreen = vec2(gl_GlobalInvocationID.xy) * tileSize * 2.0 - vec2(1.0);
    vec2 maxScreen = vec2(gl_GlobalInvocationID.xy + 1) * tileSize * 2.0 - vec2(1.0);

    // Get 4 corners of the tile at the near plane in view space
    vec3 maxPointNear = ScreenToView(vec4(maxScreen.x, maxScreen.y, -1.0, 1.0)).xyz;
    vec3 minPointNear = ScreenToView(vec4(minScreen.x, minScreen.y, -1.0, 1.0)).xyz;
    vec3 maxPointFar  = ScreenToView(vec4(maxScreen.x, maxScreen.y,  1.0, 1.0)).xyz;
    vec3 minPointFar  = ScreenToView(vec4(minScreen.x, minScreen.y,  1.0, 1.0)).xyz;

    // Logarithmic depth slicing
    float tileNear = -u_ZNear * pow(u_ZFar / u_ZNear, float(gl_GlobalInvocationID.z) / float(u_GridSize.z));
    float tileFar  = -u_ZNear * pow(u_ZFar / u_ZNear, float(gl_GlobalInvocationID.z + 1) / float(u_GridSize.z));

    vec3 minPointZNear = LineIntersectionToZPlane(vec3(0.0), minPointNear, tileNear);
    vec3 maxPointZNear = LineIntersectionToZPlane(vec3(0.0), maxPointNear, tileNear);
    vec3 minPointZFar  = LineIntersectionToZPlane(vec3(0.0), minPointFar,  tileFar);
    vec3 maxPointZFar  = LineIntersectionToZPlane(vec3(0.0), maxPointFar,  tileFar);

    vec3 aabbMin = min(min(minPointZNear, maxPointZNear), min(minPointZFar, maxPointZFar));
    vec3 aabbMax = max(max(minPointZNear, maxPointZNear), max(minPointZFar, maxPointZFar));

    clusters[clusterIndex].minPoint = vec4(aabbMin, 1.0);
    clusters[clusterIndex].maxPoint = vec4(aabbMax, 1.0);
}
