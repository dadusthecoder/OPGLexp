#version 460 core
#shader Compute

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "include/intersection.glsl"
#include "include/bvh_traversal.glsl"
#include "include/sampling.glsl"

uniform ivec3 u_ProbeCount;
uniform vec3 u_ProbeOrigin;
uniform vec3 u_ProbeSpacing;
uniform float u_MaxRayDistance;
uniform int u_FrameCounter;
uniform int u_RaysPerProbe;
uniform vec3 u_SunDirection;
uniform vec3 u_SunColor;
uniform samplerCube u_Skybox;

struct ProbeRayData {
    vec4 radiance;   // xyz = radiance at hit point, w = unused
    vec4 direction;  // xyz = ray direction, w = hit distance (-1 if miss)
};

layout(std430, binding = 6) writeonly buffer ProbeRayDataBuffer {
    ProbeRayData rayData[];
};

// Generates a random rotation matrix given a seed
mat3 RandomRotationMatrix(inout uint seed) {
    // Generate random angles
    // u = rand(), v = rand(), w = rand()
    // but a simple random rotation can be constructed by picking a random unit vector
    // and rotating around it. For DDGI, spherical fibonacci with random rotation per frame is needed.
    
    // Actually, sampling.glsl might not have RandomRotationMatrix, so we can generate a random axis-angle or just generate a random unit vector for Z, 
    // and build a TBN matrix.
    
    // Let's create a pseudo-random rotation by using the frame counter.
    // For spherical fibonacci, a random rotation matrix per frame and per probe is usually constructed.
    
    // random value between 0 and 1
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    float r1 = float((word >> 22u) ^ word) / 4294967295.0;
    
    seed = seed * 747796405u + 2891336453u;
    word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    float r2 = float((word >> 22u) ^ word) / 4294967295.0;
    
    seed = seed * 747796405u + 2891336453u;
    word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    float r3 = float((word >> 22u) ^ word) / 4294967295.0;

    // Fast-math random rotation matrix (Arvo 1992)
    float c1 = cos(2.0 * 3.14159265 * r1);
    float s1 = sin(2.0 * 3.14159265 * r1);
    float c2 = cos(2.0 * 3.14159265 * r2);
    float s2 = sin(2.0 * 3.14159265 * r2);
    float sq3 = sqrt(r3);
    float sq3i = sqrt(1.0 - r3);

    // Random rotation matrix
    mat3 R;
    R[0][0] = c1 * c2 - s1 * s2 * sq3;
    R[0][1] = s1 * c2 + c1 * s2 * sq3;
    R[0][2] = s2 * sq3i;
    R[1][0] = -c1 * s2 - s1 * c2 * sq3;
    R[1][1] = -s1 * s2 + c1 * c2 * sq3;
    R[1][2] = c2 * sq3i;
    R[2][0] = s1 * sq3i;
    R[2][1] = -c1 * sq3i;
    R[2][2] = sq3;
    
    return R;
}

void main() {
    uint probeIndex = gl_WorkGroupID.x;
    uint rayIndex = gl_LocalInvocationIndex;
    
    if (rayIndex >= uint(u_RaysPerProbe)) {
        return;
    }
    
    // Calculate 3D grid coordinates of the probe
    uint probeX = probeIndex % uint(u_ProbeCount.x);
    uint probeY = (probeIndex / uint(u_ProbeCount.x)) % uint(u_ProbeCount.y);
    uint probeZ = probeIndex / uint(u_ProbeCount.x * u_ProbeCount.y);
    
    vec3 probePos = u_ProbeOrigin + vec3(probeX, probeY, probeZ) * u_ProbeSpacing;
    
    // Generate random rotation per probe per frame
    uint seed = WangHash(probeIndex ^ uint(u_FrameCounter * 1973));
    mat3 rot = RandomRotationMatrix(seed);
    
    // Generate ray direction
    vec3 rayDir = SphericalFibonacci(rayIndex, uint(u_RaysPerProbe));
    rayDir = rot * rayDir;
    
    // Trace closest hit
    HitInfo hit = TraceClosestHit(probePos, rayDir, u_MaxRayDistance);
    
    vec3 radiance = vec3(0.0);
    float hitDistance = -1.0;
    
    if (hit.hit) {
        // We hit geometry. Evaluate direct lighting (Sun)
        vec3 hitAlbedo = vec3(0.8); // Default gray approximation
        
        vec3 sunDir = normalize(u_SunDirection); 
        vec3 sunColor = u_SunColor; 
        
        float NdotL = max(0.0, dot(hit.normal, sunDir));
        
        // Simple AnyHit shadow trace towards the sun
        vec3 shadowRayOrigin = hit.position + hit.normal * 0.05;
        bool shadowed = TraceAnyHit(shadowRayOrigin, sunDir, 100.0);
        
        if (!shadowed) {
            radiance = hitAlbedo * NdotL * sunColor;
        } else {
            // Ambient light from sky to prevent pitch black shadowed bounce
            radiance = hitAlbedo * texture(u_Skybox, hit.normal).rgb * 0.1; 
        }
        
        hitDistance = hit.distance;
    } else {
        // Miss: sky color
        radiance = texture(u_Skybox, rayDir).rgb * 2.0;
        // Keep hitDistance as -1.0 to indicate a miss
    }
    
    // Store result
    uint writeIndex = probeIndex * uint(u_RaysPerProbe) + rayIndex;
    rayData[writeIndex].radiance = vec4(radiance, 0.0);
    rayData[writeIndex].direction = vec4(rayDir, hitDistance);
}
